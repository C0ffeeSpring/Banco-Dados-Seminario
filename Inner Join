select PERSONAGEM.personagem
from PERSONAGEM
inner join ATOR
on ATOR.codAtor = PERSONAGEM.codAtor
where ATOR.nomereal = 'James Carrey';



select ATOR.NomeArtistico, PERSONAGEM.personagem
from ATOR
inner join PERSONAGEM on ATOR.codAtor = PERSONAGEM.codAtor
where ATOR.NomeReal = 'Maria da Silva';


SELECT p.nome AS nome_paciente, m.nome AS nome_medico, c.data_consulta FROM  consulta c
INNER JOIN paciente p ON c.id_paciente = p.id INNER JOIN medico m ON c.id_medico = m.id
WHERE c.data_consulta >= '2025-04-01 00:00:00' AND c.data_consulta <= '2025-04-30 23:59:59';
